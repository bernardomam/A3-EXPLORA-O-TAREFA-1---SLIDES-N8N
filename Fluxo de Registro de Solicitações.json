    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const texto = item.json.mensagem || \"\";\n  const positivas = [\"bom\", \"ótimo\", \"excelente\", \"feliz\", \"amor\", \"parabéns\", \"incrível\", \"maravilhoso\", \"perfeito\"];\n  const negativas = [\"ruim\", \"péssimo\", \"horrível\", \"triste\", \"odeio\", \"terrível\", \"lixo\", \"pior\", \"decepcionante\"];\n\n  const lower = texto.toLowerCase();\n  let sentimento = \"Neutro\";\n\n  if (positivas.some(p => lower.includes(p))) sentimento = \"Positivo\";\n  else if (negativas.some(n => lower.includes(n))) sentimento = \"Negativo\";\n\n  return {\n    json: {\n      nome: item.json.nome,\n      mensagem: item.json.mensagem,\n      sentimento: sentimento\n    }\n  };\n});"
      },
